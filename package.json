{
  "name": "diuk-windows",
  "version": "1.0.3",
  "description": "Diuk App for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "co.il.diuk.app",
    "productName": "Diuk",
    "copyright": "Copyright 2026 Diuk",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "renderer/assets/icon.ico",
      "artifactName": "diuk.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "protocols": [
      { "name": "Diuk Protocol", "schemes": ["diuk"] }
    ]
  }
}
